# Gateway
# Static Agent credentials are optional compatibility settings after enrollment support.
COMMANDER_AGENT_TOKEN=
COMMANDER_AGENT_TOKENS_JSON={}
COMMANDER_AGENT_POLICIES_JSON={"server-01":["echo","hostname","whoami","uptime"]}
COMMANDER_CONTROL_TOKEN=change-me-control-token
# Separate operator-only credential; never give this to MCP clients.
COMMANDER_APPROVAL_ADMIN_TOKEN=change-me-approval-admin-token
COMMANDER_APPROVAL_TTL_S=60
COMMANDER_AUDIT_PATH=~/.remote-mcp-commander/audit.jsonl
COMMANDER_AUDIT_FSYNC=false
COMMANDER_AUDIT_QUERY_MAX_SCAN_BYTES=2097152
COMMANDER_REGISTRY_PATH=~/.remote-mcp-commander/registry.json
COMMANDER_ENROLLMENT_TTL_S=300
COMMANDER_BIND_HOST=127.0.0.1
COMMANDER_BIND_PORT=8765
COMMANDER_REQUEST_TIMEOUT_S=15

# Agent
COMMANDER_AGENT_ID=server-01
COMMANDER_AGENT_TOKEN_FILE=~/.remote-mcp-commander/agent-token
COMMANDER_GATEWAY_WS=ws://127.0.0.1:8765/ws/agent/server-01
COMMANDER_ALLOWED_EXECUTABLES=echo,hostname,whoami,uptime
# File access is denied until one or more absolute roots are configured.
COMMANDER_ALLOWED_ROOTS_JSON=[]
COMMANDER_FILE_MAX_BYTES=1048576
COMMANDER_MAX_OUTPUT_BYTES=65536
COMMANDER_EXEC_TIMEOUT_S=10

# MCP server -> Gateway
COMMANDER_GATEWAY_HTTP=http://127.0.0.1:8765
COMMANDER_MCP_GATEWAY_TIMEOUT_S=20
COMMANDER_MCP_TRANSPORT=stdio
COMMANDER_MCP_HOST=127.0.0.1
COMMANDER_MCP_PORT=8766
COMMANDER_MCP_PATH=/mcp
COMMANDER_MCP_TOKEN=change-me-mcp-token-long-random-value
COMMANDER_MCP_ISSUER_URL=http://127.0.0.1:8766
COMMANDER_MCP_RESOURCE_URL=http://127.0.0.1:8766/mcp
COMMANDER_MCP_CLIENT_ID=remote-mcp-client
COMMANDER_MCP_SCOPE=commander:use
