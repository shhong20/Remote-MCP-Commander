# Gateway
COMMANDER_AGENT_TOKEN=change-me-default-agent-token
COMMANDER_AGENT_TOKENS_JSON={"server-01":"change-me-server-01-token"}
COMMANDER_AGENT_POLICIES_JSON={"server-01":["echo","hostname","whoami","uptime"]}
COMMANDER_CONTROL_TOKEN=change-me-control-token
COMMANDER_BIND_HOST=127.0.0.1
COMMANDER_BIND_PORT=8765
COMMANDER_REQUEST_TIMEOUT_S=15

# Agent
COMMANDER_AGENT_ID=server-01
COMMANDER_GATEWAY_WS=ws://127.0.0.1:8765/ws/agent/server-01
COMMANDER_ALLOWED_EXECUTABLES=echo,hostname,whoami,uptime
COMMANDER_MAX_OUTPUT_BYTES=65536
COMMANDER_EXEC_TIMEOUT_S=10
