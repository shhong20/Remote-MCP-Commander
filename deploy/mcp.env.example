# Same Gateway control token as deploy/gateway.env, supplied only on this host.
COMMANDER_CONTROL_TOKEN=
COMMANDER_GATEWAY_HTTP=http://127.0.0.1:8765
COMMANDER_MCP_GATEWAY_TIMEOUT_S=20

COMMANDER_MCP_TRANSPORT=streamable-http
COMMANDER_MCP_HOST=127.0.0.1
COMMANDER_MCP_PORT=8766
COMMANDER_MCP_PATH=/mcp

# Generate a separate long random MCP bearer token.
# For ChatGPT web use mcp-chatgpt.env.example instead (OAuth).
COMMANDER_MCP_AUTH_MODE=static
COMMANDER_MCP_TOKEN=
COMMANDER_MCP_ISSUER_URL=https://mcp.example.com
COMMANDER_MCP_RESOURCE_URL=https://mcp.example.com/mcp
COMMANDER_MCP_CLIENT_ID=remote-mcp-client
COMMANDER_MCP_SCOPE=commander:use
