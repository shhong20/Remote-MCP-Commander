# Keep the same Gateway control token as gateway.env, only on the server.
COMMANDER_CONTROL_TOKEN=
COMMANDER_GATEWAY_HTTP=http://127.0.0.1:8765
COMMANDER_MCP_GATEWAY_TIMEOUT_S=20

COMMANDER_MCP_TRANSPORT=streamable-http
COMMANDER_MCP_HOST=127.0.0.1
COMMANDER_MCP_PORT=8766
COMMANDER_MCP_PATH=/mcp
COMMANDER_MCP_AUTH_MODE=oauth
# OAuth mode never accepts a static bearer token.
COMMANDER_MCP_TOKEN=
# Copy the exact Auth0 OIDC issuer, including the trailing slash.
COMMANDER_MCP_ISSUER_URL=https://YOUR_TENANT.auth0.com/
# Auth0 API Identifier/audience must be exactly this public URL.
COMMANDER_MCP_RESOURCE_URL=https://mcp.example.com/mcp
COMMANDER_MCP_SCOPE=commander:use
# Auth0 User ID for YOUR login identity, not an email or client ID.
COMMANDER_MCP_OAUTH_SUBJECT=
COMMANDER_MCP_OAUTH_JWKS_CACHE_S=300
COMMANDER_MCP_OAUTH_TIMEOUT_S=5
