# Runtime key for OpenAI tunnel-client ONLY. Never paste it into a chat.
# Store the real file with owner-only permissions; do not commit it.
CONTROL_PLANE_API_KEY=
# Used by the operator's tunnel-client init command, not automatically by the CLI.
COMMANDER_TUNNEL_ID=

# Same Gateway control token as gateway.env, supplied only on the server.
COMMANDER_CONTROL_TOKEN=
COMMANDER_GATEWAY_HTTP=http://127.0.0.1:8765
COMMANDER_MCP_GATEWAY_TIMEOUT_S=20
COMMANDER_MCP_TRANSPORT=stdio

# No Auth0, public MCP URL, static MCP token or approval-admin token is needed here.
# Use remote-mcp-tunnel-stdio as the private child command, NOT an HTTP server.
