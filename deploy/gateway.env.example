# Generate long random values; CONTROL and APPROVAL tokens must be distinct.
COMMANDER_CONTROL_TOKEN=
COMMANDER_APPROVAL_ADMIN_TOKEN=
COMMANDER_APPROVAL_TTL_S=60

# Gateway is intentionally loopback-only behind the TLS reverse proxy.
COMMANDER_BIND_HOST=127.0.0.1
COMMANDER_BIND_PORT=8765
COMMANDER_REQUEST_TIMEOUT_S=15

# Must match the Agent command-policy mode. Use personal only for a trusted single-user server.
COMMANDER_OPERATION_MODE=hardened
COMMANDER_PERSONAL_PTY_APPROVAL_REQUIRED=false
COMMANDER_PERSONAL_PROCESS_APPROVAL_REQUIRED=false

# Enrolled Agent credentials are authoritative; static tokens remain empty.
COMMANDER_AGENT_TOKEN=
COMMANDER_AGENT_TOKENS_JSON={}
COMMANDER_AGENT_POLICIES_JSON={}

COMMANDER_REGISTRY_PATH=/var/lib/remote-mcp-commander/registry.json
COMMANDER_ENROLLMENT_TTL_S=300
COMMANDER_AUDIT_PATH=/var/lib/remote-mcp-commander/audit.jsonl
COMMANDER_AUDIT_FSYNC=true
COMMANDER_AUDIT_QUERY_MAX_SCAN_BYTES=2097152
