# Set this to the exact ID used during enrollment.
COMMANDER_AGENT_ID=server-01
COMMANDER_GATEWAY_WS=wss://gateway.example.com/ws/agent/server-01

# Enrollment writes the long-lived credential to the default owner-only token file.
# COMMANDER_AGENT_TOKEN_FILE=~/.remote-mcp-commander/agent-token

# Keep hardened for least privilege. Set personal for one trusted user/server to enable
# broad developer commands, user PATH/HOME, default home filesystem root, and PTY defaults.
COMMANDER_OPERATION_MODE=hardened
COMMANDER_ALLOWED_EXECUTABLES=echo,hostname,whoami,uptime
COMMANDER_MAX_OUTPUT_BYTES=65536
COMMANDER_EXEC_TIMEOUT_S=10
COMMANDER_SESSION_TIMEOUT_S=300
COMMANDER_SESSION_MAX_ACTIVE=4
COMMANDER_SESSION_HISTORY_LIMIT=100

# Explicitly expose only directories this OS user is allowed to control.
COMMANDER_ALLOWED_ROOTS_JSON=["/srv/project"]
COMMANDER_FILE_MAX_BYTES=1048576

COMMANDER_SESSION_INPUT_MAX_BYTES=16384
