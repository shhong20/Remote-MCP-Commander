[Unit]
Description=Remote MCP Commander Agent
Wants=network-online.target
After=network-online.target

[Service]
Environment=PYTHONDONTWRITEBYTECODE=1
Type=simple
EnvironmentFile=%h/.config/remote-mcp-commander/agent.env
ExecStartPre=%h/.local/share/remote-mcp-commander/current/.venv/bin/remote-mcp-doctor agent
ExecStart=%h/.local/share/remote-mcp-commander/current/.venv/bin/remote-mcp-agent
Restart=always
RestartSec=3s
UMask=0077
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
